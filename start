#!/bin/bash
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

sudo mkdir -p appdata/space-engineers/bins/SpaceEngineersDedicated || die "Failed to create SpaceEngineersDedicated directory"
sudo mkdir -p appdata/space-engineers/bins/steamcmd || die "Failed to create steamcmd directory"
sudo mkdir -p appdata/space-engineers/config/World || die "Failed to create World directory"
sudo mkdir -p appdata/space-engineers/config/Plugins || die "Failed to create Plugins directory"

if [ ! -f ./appdata/space-engineers/config/mods.txt ]; then
    printf '# Steam Workshop mod IDs, one per line\n# Find the ID in the Workshop URL: ?id=XXXXXXXXXX\n# Example: 1902970975\n' \
        | sudo tee appdata/space-engineers/config/mods.txt > /dev/null \
        || die "Failed to create mods.txt"
fi

# Config must exist before unzip so the zip's stale config is never extracted (-n flag)
if [ ! -f ./appdata/space-engineers/config/SpaceEngineers-Dedicated.cfg ]; then
    echo "No config found — copying template..."
    sudo cp SpaceEngineers-Dedicated.cfg.template \
        appdata/space-engineers/config/SpaceEngineers-Dedicated.cfg \
        || die "Failed to copy config template"
    echo ""
    echo "  Config created at appdata/space-engineers/config/SpaceEngineers-Dedicated.cfg"
    echo "  Edit it (add your Steam64 ID to <Administrators>), then run ./start again."
    echo ""
    exit 0
fi

if [ ! -f ./appdata/space-engineers/config/World/Sandbox.sbc ]; then
    echo "World not found, initializing empty star system..."
    sudo unzip -n star-system.zip -d ./appdata/space-engineers/config || die "Failed to extract star-system.zip"
fi

if [ "$(stat -c '%u' appdata)" != "1000" ]; then
    echo "Setting owner of appdata to UID 1000"
    sudo chown -R 1000:1000 appdata || die "Failed to chown appdata to 1000:1000"
fi

sudo docker compose up -d --build || die "Failed to start container"
sudo docker compose logs -f