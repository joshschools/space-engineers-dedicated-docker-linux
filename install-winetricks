#!/bin/bash
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

Xvfb :5 -screen 0 1024x768x16 &
XVFB_PID=$!
sleep 1
kill -0 "$XVFB_PID" 2>/dev/null || die "Xvfb failed to start"

env WINEARCH=win64 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree=d" WINEPREFIX=/wineprefix \
  wineboot --init /nogui \
  || die "wineboot --init failed"

env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks corefonts \
  || die "winetricks corefonts failed"

# dotnet40 must be installed before dotnet48 (48 is a patch on top of 40)
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q dotnet40 \
  || die "winetricks dotnet40 failed"

env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q --force dotnet48 \
  || die "winetricks dotnet48 failed"

# vcrun2019 bundles 2015+2017+2019, replacing the old vcrun2013+vcrun2017 combo
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q vcrun2019 \
  || die "winetricks vcrun2019 failed"

# winetricks creates HKLM\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64 but NOT
# the Classes\Installer\Dependencies key that SE DS actually checks at startup.
# Add it manually using the version winetricks installed.
VCVER=$(env WINEPREFIX=/wineprefix wine reg query \
  "HKLM\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64" \
  /v Version 2>/dev/null | awk '/Version/{print $NF}' | tr -d '\r')
[ -n "$VCVER" ] || VCVER="14.42.34433.0"
env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  wine reg add \
  "HKLM\\SOFTWARE\\Classes\\Installer\\Dependencies\\Microsoft.VS.VC_RuntimeAdditionalVSU_amd64,v14" \
  /v "Version" /t REG_SZ /d "$VCVER" /f \
  || die "Failed to add VC++ Installer\\Dependencies registry key"

# faudio provides XAudio2 support needed for headless audio init
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q faudio \
  || die "winetricks faudio failed"

env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks sound=disabled \
  || die "winetricks sound=disabled failed"

kill "$XVFB_PID" 2>/dev/null || true
rm -rf ~/.cache
