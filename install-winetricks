#!/bin/bash
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

Xvfb :5 -screen 0 1024x768x16 &
XVFB_PID=$!
sleep 1
kill -0 "$XVFB_PID" 2>/dev/null || die "Xvfb failed to start"

env WINEARCH=win64 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree=d" WINEPREFIX=/wineprefix \
  wineboot --init /nogui \
  || die "wineboot --init failed"

env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks corefonts \
  || die "winetricks corefonts failed"

# Wine 11's builtin mscoree.dll writes .NET NDP registry keys when it loads.
# Deleting the keys from system.reg isn't enough: winetricks' intermediate wine
# calls (remove_mono, winecfg) start a wineserver that loads mscoree and
# re-creates the keys before the installer runs, causing exit 236.
# Fix: kill wineserver to flush disk state, strip NDP keys from system.reg,
# AND set mscoree=disabled in user.reg DllOverrides so no wine process can
# load the builtin and re-create the keys. winetricks' dotnet40 post-install
# will overwrite the override to "native" once the real mscoree.dll is in place.
env WINEARCH=win64 WINEPREFIX=/wineprefix wineserver -k 2>/dev/null || true
sleep 2
python3 - << 'PYEOF'
import pathlib, re

# Strip NDP sections from system.reg
reg = pathlib.Path('/wineprefix/system.reg')
lines = reg.read_text().split('\n')
result, in_ndp, removed = [], False, 0
for line in lines:
    if line.startswith('['):
        in_ndp = '\\\\NET Framework Setup\\\\NDP' in line
    if in_ndp:
        removed += 1
    else:
        result.append(line)
reg.write_text('\n'.join(result))
print(f'Removed {removed} NDP lines from system.reg')

# Add mscoree=disabled to HKCU DllOverrides in user.reg so the builtin mscoree
# cannot load and re-populate the NDP keys during winetricks' internal wine calls.
user_reg = pathlib.Path('/wineprefix/user.reg')
uc = user_reg.read_text()
if '"mscoree"=' in uc:
    uc = re.sub(r'"mscoree"="[^"]*"', '"mscoree"="disabled"', uc)
    print('Updated mscoree=disabled in user.reg')
elif '[Software\\\\Wine\\\\DllOverrides]' in uc:
    uc = re.sub(
        r'(\[Software\\\\Wine\\\\DllOverrides\][^\n]*\n(?:#time=[^\n]+\n)?)',
        r'\1"mscoree"="disabled"\n',
        uc,
    )
    print('Added mscoree=disabled to user.reg DllOverrides')
else:
    uc += '\n[Software\\\\Wine\\\\DllOverrides] 1779755420\n#time=1dceca6d5365a46\n"mscoree"="disabled"\n'
    print('Created DllOverrides section with mscoree=disabled in user.reg')
user_reg.write_text(uc)
PYEOF
[ $? -eq 0 ] || die "Failed to clear NDP keys / set mscoree override"

# dotnet40 must be installed before dotnet48 (48 is a patch on top of 40)
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q --force dotnet40 \
  || die "winetricks dotnet40 failed"

env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q --force dotnet48 \
  || die "winetricks dotnet48 failed"

# vcrun2019 bundles 2015+2017+2019, replacing the old vcrun2013+vcrun2017 combo
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q vcrun2019 \
  || die "winetricks vcrun2019 failed"

# winetricks creates HKLM\...\VisualStudio\14.0\VC\Runtimes\x64 but NOT the
# Classes\Installer\Dependencies key that SE DS actually checks at startup.
# Write it directly to system.reg to avoid wineserver flush timing issues.
python3 - << 'PYEOF'
import re, sys

reg = '/wineprefix/system.reg'
with open(reg, 'r') as f:
    content = f.read()

m = re.search(r'Runtimes\\\\x64\].*?"Version"="([^"]+)"', content, re.DOTALL)
vcver = m.group(1) if m else '14.42.34433.0'

m2 = re.search(r'\[Software\\\\.+?\] (\d+)', content)
ts = m2.group(1) if m2 else '1779755420'

key = (
    f'\n[Software\\\\Classes\\\\Installer\\\\Dependencies\\\\'
    f'Microsoft.VS.VC_RuntimeAdditionalVSU_amd64,v14] {ts}\n'
    f'#time=1dceca6d5365a46\n'
    f'"Version"="{vcver}"\n'
)
with open(reg, 'a') as f:
    f.write(key)
print(f'Added Installer\\Dependencies registry key (version {vcver})')
PYEOF
[ $? -eq 0 ] || die "Failed to write VC++ Installer\\Dependencies registry key"

# faudio provides XAudio2 support needed for headless audio init
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q faudio \
  || die "winetricks faudio failed"

env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks sound=disabled \
  || die "winetricks sound=disabled failed"

kill "$XVFB_PID" 2>/dev/null || true
rm -rf ~/.cache
