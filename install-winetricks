#!/bin/bash
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

Xvfb :5 -screen 0 1024x768x16 &
XVFB_PID=$!
sleep 1
kill -0 "$XVFB_PID" 2>/dev/null || die "Xvfb failed to start"

env WINEARCH=win64 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree=d" WINEPREFIX=/wineprefix \
  wineboot --init /nogui \
  || die "wineboot --init failed"

env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks corefonts \
  || die "winetricks corefonts failed"

# Wine 11 pre-populates .NET NDP registry keys that cause the dotnet40 installer
# to exit 236 ("newer version detected") without installing any files. Delete them
# so the installer sees a clean slate. The keys are recreated by the installer.
env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  wine reg delete "HKLM\\SOFTWARE\\Microsoft\\NET Framework Setup\\NDP" /f \
  2>/dev/null || true
env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  wine reg delete "HKLM\\SOFTWARE\\Wow6432Node\\Microsoft\\NET Framework Setup\\NDP" /f \
  2>/dev/null || true

# dotnet40 must be installed before dotnet48 (48 is a patch on top of 40)
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q --force dotnet40 \
  || die "winetricks dotnet40 failed"

env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q --force dotnet48 \
  || die "winetricks dotnet48 failed"

# vcrun2019 bundles 2015+2017+2019, replacing the old vcrun2013+vcrun2017 combo
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q vcrun2019 \
  || die "winetricks vcrun2019 failed"

# winetricks creates HKLM\...\VisualStudio\14.0\VC\Runtimes\x64 but NOT the
# Classes\Installer\Dependencies key that SE DS actually checks at startup.
# Write it directly to system.reg to avoid wineserver flush timing issues.
python3 - << 'PYEOF'
import re, sys

reg = '/wineprefix/system.reg'
with open(reg, 'r') as f:
    content = f.read()

m = re.search(r'Runtimes\\\\x64\].*?"Version"="([^"]+)"', content, re.DOTALL)
vcver = m.group(1) if m else '14.42.34433.0'

m2 = re.search(r'\[Software\\\\.+?\] (\d+)', content)
ts = m2.group(1) if m2 else '1779755420'

key = (
    f'\n[Software\\\\Classes\\\\Installer\\\\Dependencies\\\\'
    f'Microsoft.VS.VC_RuntimeAdditionalVSU_amd64,v14] {ts}\n'
    f'#time=1dceca6d5365a46\n'
    f'"Version"="{vcver}"\n'
)
with open(reg, 'a') as f:
    f.write(key)
print(f'Added Installer\\Dependencies registry key (version {vcver})')
PYEOF
[ $? -eq 0 ] || die "Failed to write VC++ Installer\\Dependencies registry key"

# faudio provides XAudio2 support needed for headless audio init
env DISPLAY=:5.0 WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks -q faudio \
  || die "winetricks faudio failed"

env WINEARCH=win64 WINEDEBUG=-all WINEPREFIX=/wineprefix \
  winetricks sound=disabled \
  || die "winetricks sound=disabled failed"

kill "$XVFB_PID" 2>/dev/null || true
rm -rf ~/.cache
